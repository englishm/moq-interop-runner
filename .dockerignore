# Build context for builds whose Dockerfile needs files from several directories
# (builds/stitcher-moq-media uses the repository root to reach lib/media/). Keep the
# context small: no VCS data, generated artifacts, cloned sources or local outputs.
.git
certs/
results/
mlog/
builds/*/.sources/
builds/*/.last-build.json
builds/*/target/
builds/*/node_modules/
__pycache__/
.plan/
