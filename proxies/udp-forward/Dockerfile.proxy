# Stand-in MoQT proxy: forwards UDP datagrams to the relay unchanged.
# Used to test the runner's proxy hop. See README.md and docs/PROXY-TESTING.md.
FROM alpine:3.20
RUN apk add --no-cache socat
COPY --chmod=0755 entrypoint-proxy.sh /usr/local/bin/entrypoint-proxy.sh
EXPOSE 4443/udp
ENTRYPOINT ["/usr/local/bin/entrypoint-proxy.sh"]
