  "known_driver_risks": {
    "moxygen_global_cross_stream_ordering": {
      "status": "open-until-fixed-executable-sha",
      "description": "The reviewed moxygen baseline can falsely fail when independently scheduled subgroup streams arrive in a different global group order.",
      "result_rule": "Before registration, retain an ordering-only mismatch only in manual evidence as driver-inconclusive with evaluator verdict inconclusive; never classify the relay as failed. The current TAP report cannot represent this state.",
      "resolved_by_sha": "TBD"
    }
  },
  "disposition_reasons": {
    "profiled-subscribe-stream": "Intended for runner execution as a subscription stream case; intended is a plan, not an observed support claim.",
    "delivery-timeout-parameter-only": "Intended only for non-expiring delivery-timeout parameter observation; timeout expiration is not claimed.",
    "fetch-unsupported": "Deferred because FETCH is outside this profile and no FETCH support is claimed.",
    "datagram-unsupported": "Deferred because datagram delivery is outside this profile and no datagram support is claimed.",
    "object-status-unsupported": "Deferred because the declaration requests explicit end-of-group/Object Status behavior, which is outside this profile.",
    "subscribe-tracks-unsupported": "Deferred because the composite PUBLISH topology requires SUBSCRIBE_TRACKS, which is outside this profile.",
    "subscribe-tracks-request-update-unsupported": "Deferred because the publish-first composite topology requires SUBSCRIBE_TRACKS and REQUEST_UPDATE, both outside this profile.",
    "publisher-delivery-timeout-unsupported": "Deferred because publisher delivery timeout behavior and timeout expiration are outside this profile."
  },
  "implementation_independence_classes": {
    "planned-independent-gate": "This moxygen source binding maps to a runner gate that also has a separately authored independent publisher/subscriber binding.",
    "profile-inventory-only": "Inventoried as intended, but no independent canonical diagnostic gate is specified in this revision.",
    "deferred-unsupported": "Excluded from execution and support claims in this revision."
  },
  "result_semantics": [
    {"id": "pass", "meaning": "All fail-closed criteria were satisfied and required evidence is complete."},
    {"id": "fail", "meaning": "At least one protocol criterion or selected binding fixture expectation was contradicted by complete evidence."},
    {"id": "inconclusive", "meaning": "Execution reached the test but evidence cannot distinguish pass from fail."},
    {"id": "unsupported", "meaning": "The selected case or required capability is not implemented by the client."},
    {"id": "not-run", "meaning": "The case was not attempted."},
    {"id": "harness-error", "meaning": "Setup, readiness, orchestration, parsing, or evidence capture failed."
    }
  ],
  "required_evidence": {
    "publisher-readiness": "Binding-specific evidence that the active publisher route was ready for this exact case, not a separate announce-only probe.",
    "control-observations": "Decoded SETUP, SUBSCRIBE, SUBSCRIBE_OK or REQUEST_ERROR, and PUBLISH_DONE or request termination observations with connection roles and ordering.",
    "object-observations": "Per-object group ID, object ID, subgroup ID, exact payload bytes and digest, publisher priority, and raw plus decoded Object Property type/value observations.",
    "delivery-observations": "Binding-specific wire-level or serve-model delivery observations sufficient for that binding's declared assertions.",
    "tap14": "The complete TAP version 14 output and process exit code.",
    "process-logs": "Complete publisher-driver, relay, and subscriber-driver stdout and stderr with timestamps.",
    "reproduction-metadata": "A result record conforming to result_record_contract, including exact revisions and deployment provenance."
  },
  "binding_evidence_contracts": {
    "moxygen_driver": {
      "readiness": "Observe PUBLISH_NAMESPACE REQUEST_OK for the same active case before starting its subscriber; an announce-only run is not proof of case readiness.",
      "delivery": ["wire-control-messages", "wire-subgroup-headers", "wire-object-observations", "wire-fin-or-reset"],
      "completion": "Wire evidence accounts for the expected objects and stream FIN dispositions."
    },
    "independent_moq_test_client": {
      "readiness": "Observe both SUBSCRIBE_OK and exact namespace-plus-track routing to the publisher serve model.",
      "delivery": ["serve-model-subgroup-identity", "serve-model-publisher-priority", "serve-model-object-identity", "serve-model-object-status", "serve-model-object-properties", "serve-model-payload-bytes"],
      "completion": "Observe TRACK_ENDED after the finite serve-model fixture is consumed.",
      "not_directly_observed": ["publish-namespace-request-ok", "raw-object-id-deltas", "first-object-bit", "wire-fin-or-reset"]
    }
  },
  "result_record_contract": {
    "version": "1.0.0",
    "schema_ref": "./moxygen-draft18-support-profile.schema.json#/definitions/result_record",
    "identity_rule": "gate_id and gate_revision identify the runner gate; source_binding is populated only for the moxygen driver binding.",
    "state_model": {
      "disposition": ["intended", "deferred"],
      "execution": ["not-run", "started", "completed", "aborted"],
      "evaluator_verdict": ["pass", "fail", "inconclusive", "unsupported", "harness-error"],
      "claimed_outcome": ["pass", "fail", "inconclusive", "unsupported", "not-run", "harness-error"],
      "failure_classification": ["none", "profile-mismatch", "protocol-contradiction", "mixed", "driver-inconclusive"],
      "rule": "Disposition is profile eligibility, execution is what happened, evaluator_verdict is the evidence judgment, and claimed_outcome is the driver or exported claim under evaluation. A claimed pass can be overturned by the evaluator."
    },
    "independence_classes": [
      "moxygen-driver-binding",
      "independent-generator-and-oracle"
    ],
    "assertion_descriptor": {
      "required": ["id", "description", "basis", "status", "expected", "observed", "evidence_ids"],
      "unique_by": "id"
    },
    "evidence_descriptor": {
      "required": ["id", "category", "kind", "sha256", "media_type", "byte_length", "producer", "captured_at_utc", "locator"],
      "unique_by": "id",
      "digest": "SHA-256 over the exact referenced evidence bytes, encoded as 64 lowercase hexadecimal characters. Schema and jq validation check syntax only; external publication must recompute each digest from the artifact bytes."
    },
    "opaque_deployment_policy": {
      "rule": "A deployment with no verifiable image digest must use visibility=opaque, image_digest=null, and a non-empty opaque reason and locator. It must not use a guessed digest or be described as reproducible.",
      "result_handling": "Opaque runs may report protocol observations, but the record must set reproducibility=opaque and preserve the limitation in every exported claim."
    },
    "verification_rule": "reproducibility and independence_class are submitted claims. A publishable evaluator pass requires evidence_integrity_verification=verified and provenance_verification=verified from external publication tooling.",
    "executable_provenance_rule": "Manifest executable landing fields may be unresolved/TBD, but executable result records require full 40-character landing SHAs and must never contain TBD."
  },
