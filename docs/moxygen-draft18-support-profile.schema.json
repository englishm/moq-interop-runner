{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/englishm/moq-interop-runner/blob/main/docs/moxygen-draft18-support-profile.schema.json",
  "title": "moxygen draft-18 support profile and result record contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "profile", "provenance", "oracle", "identifier_policy", "capability_boundaries", "execution_policy", "executable_requirements", "known_driver_risks", "disposition_reasons", "implementation_independence_classes", "result_semantics", "required_evidence", "binding_evidence_contracts", "result_record_contract", "cases", "gates"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "revision", "draft", "declaration_count", "intended_count", "deferred_count", "diagnostic_gate_count"],
      "properties": {
        "id": {"const": "moxygen-draft18-support-profile"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "revision": {"type": "integer", "minimum": 1},
        "draft": {"const": "draft-ietf-moq-transport-18"},
        "declaration_count": {"const": 58},
        "intended_count": {"const": 29},
        "deferred_count": {"const": 29},
        "diagnostic_gate_count": {"const": 7}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_baselines", "executable_landings"],
      "properties": {
        "reference_baselines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["normative_draft", "moxygen_declarations", "moq_rs_review", "runner_baseline"],
          "properties": {"normative_draft": {"$ref": "#/definitions/pinned_source"}, "moxygen_declarations": {"$ref": "#/definitions/pinned_source"}, "moq_rs_review": {"$ref": "#/definitions/pinned_source"}, "runner_baseline": {"$ref": "#/definitions/pinned_source"}}
        },
        "executable_landings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["moxygen_conformance_driver", "rust_diagnostic_gates"],
          "properties": {"moxygen_conformance_driver": {"$ref": "#/definitions/unresolved_executable_with_image"}, "rust_diagnostic_gates": {"$ref": "#/definitions/unresolved_executable"}}
        }
      }
    },
    "oracle": {"type": "object", "additionalProperties": false, "required": ["classification", "components", "normative_authority", "semantic_layer", "binding_rule", "independence_rule"], "properties": {"classification": {"const": "ecosystem-executable-specification"}, "components": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "normative_authority": {"const": "draft-ietf-moq-transport-18"}, "semantic_layer": {"type": "string", "minLength": 1}, "binding_rule": {"type": "string", "minLength": 1}, "independence_rule": {"type": "string", "minLength": 1}}},
    "identifier_policy": {"type": "object", "additionalProperties": false, "required": ["gate_ids", "case_ids", "source_ordinals_and_names"], "properties": {"gate_ids": {"type": "string"}, "case_ids": {"type": "string"}, "source_ordinals_and_names": {"type": "string"}}},
    "capability_boundaries": {"type": "object", "additionalProperties": false, "required": ["not_claimed"], "properties": {"not_claimed": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}}}},
    "execution_policy": {"type": "object", "additionalProperties": false, "required": ["readiness_timeout_ms", "runner_whole_container_limit_ms", "diagnostic_gate_timeouts_ms", "intended_case_timeouts_ms", "rule"], "properties": {"readiness_timeout_ms": {"type": "integer", "minimum": 1}, "runner_whole_container_limit_ms": {"type": "integer", "minimum": 1}, "diagnostic_gate_timeouts_ms": {"type": "object", "minProperties": 7, "maxProperties": 7, "additionalProperties": {"type": "integer", "minimum": 1}}, "intended_case_timeouts_ms": {"type": "object", "minProperties": 29, "maxProperties": 29, "additionalProperties": {"type": "integer", "minimum": 1}}, "rule": {"type": "string", "minLength": 1}}},
    "executable_requirements": {"type": "object", "additionalProperties": false, "required": ["tls_disable_verify", "resolved_provenance"], "properties": {"tls_disable_verify": {"type": "string", "minLength": 1}, "resolved_provenance": {"type": "string", "minLength": 1}}},
    "known_driver_risks": {"type": "object", "additionalProperties": false, "required": ["moxygen_global_cross_stream_ordering"], "properties": {"moxygen_global_cross_stream_ordering": {"type": "object", "additionalProperties": false, "required": ["status", "description", "result_rule", "resolved_by_sha"], "properties": {"status": {"const": "open-until-fixed-executable-sha"}, "description": {"type": "string"}, "result_rule": {"type": "string"}, "resolved_by_sha": {"const": "TBD"}}}}},
    "disposition_reasons": {"type": "object", "additionalProperties": false, "required": ["profiled-subscribe-stream", "delivery-timeout-parameter-only", "fetch-unsupported", "datagram-unsupported", "object-status-unsupported", "subscribe-tracks-unsupported", "subscribe-tracks-request-update-unsupported", "publisher-delivery-timeout-unsupported"], "properties": {"profiled-subscribe-stream": {"type": "string", "minLength": 1}, "delivery-timeout-parameter-only": {"type": "string", "minLength": 1}, "fetch-unsupported": {"type": "string", "minLength": 1}, "datagram-unsupported": {"type": "string", "minLength": 1}, "object-status-unsupported": {"type": "string", "minLength": 1}, "subscribe-tracks-unsupported": {"type": "string", "minLength": 1}, "subscribe-tracks-request-update-unsupported": {"type": "string", "minLength": 1}, "publisher-delivery-timeout-unsupported": {"type": "string", "minLength": 1}}},
    "implementation_independence_classes": {"type": "object", "additionalProperties": false, "required": ["planned-independent-gate", "profile-inventory-only", "deferred-unsupported"], "properties": {"planned-independent-gate": {"type": "string", "minLength": 1}, "profile-inventory-only": {"type": "string", "minLength": 1}, "deferred-unsupported": {"type": "string", "minLength": 1}}},
    "result_semantics": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "meaning"],
        "properties": {"id": {"enum": ["pass", "fail", "inconclusive", "unsupported", "not-run", "harness-error"]}, "meaning": {"type": "string", "minLength": 1}}
      }
    },
    "required_evidence": {"type": "object", "additionalProperties": false, "required": ["publisher-readiness", "control-observations", "object-observations", "delivery-observations", "tap14", "process-logs", "reproduction-metadata"], "properties": {"publisher-readiness": {"type": "string", "minLength": 1}, "control-observations": {"type": "string", "minLength": 1}, "object-observations": {"type": "string", "minLength": 1}, "delivery-observations": {"type": "string", "minLength": 1}, "tap14": {"type": "string", "minLength": 1}, "process-logs": {"type": "string", "minLength": 1}, "reproduction-metadata": {"type": "string", "minLength": 1}}},
    "binding_evidence_contracts": {"type": "object", "additionalProperties": false, "required": ["moxygen_driver", "independent_moq_test_client"], "properties": {"moxygen_driver": {"type": "object", "additionalProperties": false, "required": ["readiness", "delivery", "completion"], "properties": {"readiness": {"type": "string", "minLength": 1}, "delivery": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "completion": {"type": "string", "minLength": 1}}}, "independent_moq_test_client": {"type": "object", "additionalProperties": false, "required": ["readiness", "delivery", "completion", "not_directly_observed"], "properties": {"readiness": {"type": "string", "minLength": 1}, "delivery": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "completion": {"type": "string", "minLength": 1}, "not_directly_observed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}}},
    "result_record_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "schema_ref", "identity_rule", "state_model", "independence_classes", "assertion_descriptor", "evidence_descriptor", "opaque_deployment_policy", "verification_rule", "executable_provenance_rule"],
      "properties": {
        "version": {"const": "1.0.0"},
        "schema_ref": {"const": "./moxygen-draft18-support-profile.schema.json#/definitions/result_record"},
        "identity_rule": {"type": "string", "minLength": 1},
        "state_model": {"type": "object", "additionalProperties": false, "required": ["disposition", "execution", "evaluator_verdict", "claimed_outcome", "failure_classification", "rule"], "properties": {"disposition": {"type": "array", "items": {"enum": ["intended", "deferred"]}, "uniqueItems": true}, "execution": {"type": "array", "items": {"enum": ["not-run", "started", "completed", "aborted"]}, "uniqueItems": true}, "evaluator_verdict": {"type": "array", "items": {"enum": ["pass", "fail", "inconclusive", "unsupported", "harness-error"]}, "uniqueItems": true}, "claimed_outcome": {"type": "array", "items": {"enum": ["pass", "fail", "inconclusive", "unsupported", "not-run", "harness-error"]}, "uniqueItems": true}, "failure_classification": {"type": "array", "items": {"enum": ["none", "profile-mismatch", "protocol-contradiction", "mixed", "driver-inconclusive"]}, "uniqueItems": true}, "rule": {"type": "string", "minLength": 1}}},
        "independence_classes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["moxygen-driver-binding", "independent-generator-and-oracle"]}},
        "assertion_descriptor": {"type": "object", "additionalProperties": false, "required": ["required", "unique_by"], "properties": {"required": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "unique_by": {"const": "id"}}},
        "evidence_descriptor": {"type": "object", "additionalProperties": false, "required": ["required", "unique_by", "digest"], "properties": {"required": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "unique_by": {"const": "id"}, "digest": {"type": "string", "minLength": 1}}},
        "opaque_deployment_policy": {"type": "object", "additionalProperties": false, "required": ["rule", "result_handling"], "properties": {"rule": {"type": "string", "minLength": 1}, "result_handling": {"type": "string", "minLength": 1}}},
        "verification_rule": {"type": "string", "minLength": 1},
        "executable_provenance_rule": {"type": "string", "minLength": 1}
      }
    },
    "cases": {"type": "array", "minItems": 58, "maxItems": 58, "items": {"$ref": "#/definitions/case"}},
    "gates": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/definitions/gate"}}
  },
  "definitions": {
    "pinned_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sha"],
      "properties": {"repository": {"type": "string", "format": "uri"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tag": {"type": "string", "minLength": 1}, "declaration_file": {"type": "string", "minLength": 1}}
    },
    "unresolved_executable": {"type": "object", "additionalProperties": false, "required": ["status", "sha"], "properties": {"status": {"const": "unresolved"}, "sha": {"const": "TBD"}}},
    "unresolved_executable_with_image": {"type": "object", "additionalProperties": false, "required": ["status", "sha", "image_digest"], "properties": {"status": {"const": "unresolved"}, "sha": {"const": "TBD"}, "image_digest": {"const": "TBD"}}},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "source_name", "source_section", "request", "disposition", "reason", "independence", "gate_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^MOXYGEN-D18-CASE-[0-9]{3}$"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 58},
        "source_name": {"type": "string", "minLength": 1},
        "source_section": {"type": "string", "minLength": 1},
        "request": {"enum": ["subscribe", "fetch", "publish"]},
        "disposition": {"enum": ["intended", "deferred"]},
        "reason": {"type": "string", "minLength": 1},
        "independence": {"enum": ["planned-independent-gate", "profile-inventory-only", "deferred-unsupported"]},
        "gate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^MOXYGEN-D18-DG-[0-9]{3}$"}}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "moxygen_source_binding_id", "normative_references", "semantic_contract", "bindings", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^MOXYGEN-D18-DG-[0-9]{3}$"},
        "revision": {"const": 1},
        "moxygen_source_binding_id": {"type": "string", "pattern": "^MOXYGEN-D18-CASE-[0-9]{3}$"},
        "normative_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "semantic_contract": {"$ref": "#/definitions/semantic_contract"},
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["moxygen_driver", "independent_moq_test_client"],
          "properties": {"moxygen_driver": {"$ref": "#/definitions/moxygen_binding"}, "independent_moq_test_client": {"$ref": "#/definitions/independent_binding"}}
        },
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "semantic_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology_roles", "scenario", "success_criteria"],
      "properties": {
        "topology_roles": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["publisher", "relay-under-test", "subscriber"]}},
        "scenario": {"type": "string", "minLength": 1},
        "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "moxygen_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "source_ordinal", "source_name", "topology", "readiness", "vector"],
      "properties": {
        "classification": {"const": "moxygen-driver-binding"},
        "source_ordinal": {"type": "integer", "minimum": 1, "maximum": 58},
        "source_name": {"type": "string", "minLength": 1},
        "topology": {"const": "moxygen moqtest_server -> relay-under-test -> moxygen moqtest_client"},
        "readiness": {"type": "string", "minLength": 1},
        "vector": {"$ref": "#/definitions/moxygen_vector"}
      }
    },
    "independent_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "planned_function", "topology", "derivation", "vector"],
      "properties": {
        "classification": {"const": "independent-generator-and-oracle"},
        "planned_function": {"type": "string", "pattern": "^test_moqt18_subscribe_[a-z0-9_]+$"},
        "topology": {"const": "independent publisher role -> relay-under-test -> independent subscriber role"},
        "derivation": {"type": "string", "minLength": 1},
        "vector": {"$ref": "#/definitions/independent_vector"}
      }
    },
    "moxygen_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_namespace", "track_name", "groups", "object_ids", "expected_object_count", "expected_stream_count", "payload", "publisher_priority"],
      "properties": {"track_namespace": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"type": "string"}}, "track_name": {"type": "string"}, "groups": {"type": "array", "items": {"type": "integer"}}, "object_ids": {"type": "array", "items": {"type": "integer"}}, "subgroups": {"type": "object"}, "subgroup_rule": {"type": "string"}, "expected_object_count": {"type": "integer"}, "expected_stream_count": {"type": "integer"}, "payload": {"type": "object"}, "publisher_priority": {"type": "object"}, "object_property_types": {"type": "array"}, "object_properties": {"type": "array"}, "property_order_asserted": {"type": "boolean"}, "gap_properties_present": {"const": false}}
    },
    "independent_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace_prefix", "namespace_rule", "publisher_cid_component", "track_name", "groups", "object_ids", "subgroups", "publisher_priority_by_subgroup", "payloads"],
      "properties": {
        "namespace_prefix": {"type": "string", "pattern": "^moq-test/moqt18/[a-z0-9-]+$"},
        "namespace_rule": {"type": "string", "pattern": "^moq-test/moqt18/[a-z0-9-]+/\\{publisher_cid\\}$"},
        "publisher_cid_component": {"type": "object", "additionalProperties": false, "required": ["source", "purpose"], "properties": {"source": {"const": "publisher_connection_id"}, "purpose": {"type": "string", "minLength": 1}}},
        "track_name": {"type": "string", "minLength": 1},
        "groups": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "object_ids": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "subgroups": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "integer"}}},
        "publisher_priority_by_subgroup": {"type": "object", "propertyNames": {"pattern": "^[0-9]+/[0-9]+$"}, "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 255}},
        "payloads": {"$ref": "#/definitions/fixed_payload_contract"},
        "object_properties_by_object": {"type": "object", "propertyNames": {"pattern": "^[0-9]+$"}, "additionalProperties": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/independent_object_property"}}},
        "object_property_ranges": {"type": "object"},
        "gap_properties_present": {"const": false}
      }
    },
    "fixed_payload_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "unique_per_object", "verification", "items"],
      "properties": {"kind": {"const": "fixed-source-constants"}, "unique_per_object": {"const": true}, "verification": {"const": "exact-byte-match"}, "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/fixed_payload"}}}
    },
    "fixed_payload": {"type": "object", "additionalProperties": false, "required": ["group", "subgroup", "object", "ascii", "hex"], "properties": {"group": {"type": "integer", "minimum": 0}, "subgroup": {"type": "integer", "minimum": 0}, "object": {"type": "integer", "minimum": 0}, "ascii": {"type": "string", "minLength": 1}, "hex": {"type": "string", "pattern": "^([0-9a-f]{2})+$"}}},
    "independent_object_property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "type_hex", "value_kind", "value_hex"],
      "properties": {
        "type": {"type": "integer", "minimum": 0, "not": {"minimum": 16384, "maximum": 32767}},
        "type_hex": {"type": "string", "pattern": "^0x[0-9a-f]+$"},
        "value_kind": {"enum": ["integer", "bytes"]},
        "value": {"type": "integer", "minimum": 0},
        "value_ascii": {"type": "string"},
        "value_hex": {"type": "string", "pattern": "^(0x)?[0-9a-f]+$"}
      },
      "oneOf": [
        {"properties": {"value_kind": {"const": "integer"}}, "required": ["value"]},
        {"properties": {"value_kind": {"const": "bytes"}}, "required": ["value_ascii"]}
      ]
    },
    "result_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "disposition", "execution", "evaluator_verdict", "claimed_outcome", "failure_classification", "independence_class", "reproducibility", "evidence_integrity_verification", "provenance_verification", "opaque_limitations", "protocol", "revisions", "deployments", "assertions", "evidence", "reproduction", "started_at_utc", "duration_ms"],
      "properties": {
        "identity": {"$ref": "#/definitions/result_identity"},
        "disposition": {"enum": ["intended", "deferred"]},
        "execution": {"enum": ["not-run", "started", "completed", "aborted"]},
        "evaluator_verdict": {"oneOf": [{"enum": ["pass", "fail", "inconclusive", "unsupported", "harness-error"]}, {"type": "null"}]},
        "claimed_outcome": {"enum": ["pass", "fail", "inconclusive", "unsupported", "not-run", "harness-error"]},
        "failure_classification": {"enum": ["none", "profile-mismatch", "protocol-contradiction", "mixed", "driver-inconclusive"]},
        "independence_class": {"enum": ["moxygen-driver-binding", "independent-generator-and-oracle"]},
        "reproducibility": {"enum": ["reproducible", "opaque"]},
        "evidence_integrity_verification": {"enum": ["submitted", "verified", "failed"]},
        "provenance_verification": {"enum": ["submitted", "verified", "failed"]},
        "opaque_limitations": {"type": "array", "items": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}},
        "protocol": {"$ref": "#/definitions/actual_protocol"},
        "revisions": {"$ref": "#/definitions/exact_revisions"},
        "deployments": {"type": "object", "additionalProperties": false, "required": ["publisher", "relay", "subscriber"], "properties": {"publisher": {"allOf": [{"$ref": "#/definitions/deployment"}, {"properties": {"role": {"const": "publisher"}}}]}, "relay": {"allOf": [{"$ref": "#/definitions/deployment"}, {"properties": {"role": {"const": "relay"}}}]}, "subscriber": {"allOf": [{"$ref": "#/definitions/deployment"}, {"properties": {"role": {"const": "subscriber"}}}]}}},
        "assertions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/assertion"}},
        "evidence": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"$ref": "#/definitions/evidence"}, "allOf": [
          {"contains": {"properties": {"category": {"const": "publisher-readiness"}}, "required": ["category"]}},
          {"contains": {"properties": {"category": {"const": "control-observations"}}, "required": ["category"]}},
          {"contains": {"properties": {"category": {"const": "object-observations"}}, "required": ["category"]}},
          {"contains": {"properties": {"category": {"const": "delivery-observations"}}, "required": ["category"]}},
          {"contains": {"properties": {"category": {"const": "tap14"}}, "required": ["category"]}},
          {"contains": {"properties": {"category": {"const": "process-logs"}}, "required": ["category"]}},
          {"contains": {"properties": {"category": {"const": "reproduction-metadata"}}, "required": ["category"]}}
        ]},
        "reproduction": {"$ref": "#/definitions/reproduction"},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0}
      },
      "oneOf": [
        {"properties": {"execution": {"const": "not-run"}, "evaluator_verdict": {"type": "null"}, "claimed_outcome": {"enum": ["not-run", "unsupported"]}}},
        {"properties": {"execution": {"const": "started"}, "evaluator_verdict": {"type": "null"}, "claimed_outcome": {"const": "not-run"}}},
        {"properties": {"execution": {"const": "aborted"}, "evaluator_verdict": {"enum": ["inconclusive", "harness-error"]}}},
        {"properties": {"execution": {"const": "completed"}, "evaluator_verdict": {"enum": ["pass", "fail", "inconclusive", "unsupported", "harness-error"]}, "claimed_outcome": {"enum": ["pass", "fail", "inconclusive", "unsupported", "harness-error"]}}}
      ],
      "allOf": [
        {"if": {"properties": {"evaluator_verdict": {"const": "pass"}}}, "then": {"properties": {"disposition": {"const": "intended"}, "execution": {"const": "completed"}, "failure_classification": {"const": "none"}, "evidence_integrity_verification": {"const": "verified"}, "provenance_verification": {"const": "verified"}, "assertions": {"minItems": 1, "items": {"allOf": [{"$ref": "#/definitions/assertion"}, {"properties": {"status": {"const": "pass"}}}]}}}}},
        {"if": {"properties": {"evaluator_verdict": {"const": "fail"}}}, "then": {"properties": {"failure_classification": {"enum": ["profile-mismatch", "protocol-contradiction", "mixed"]}}}},
        {"if": {"properties": {"failure_classification": {"const": "driver-inconclusive"}}}, "then": {"properties": {"evaluator_verdict": {"const": "inconclusive"}, "identity": {"properties": {"driver_binding": {"const": "moxygen_driver"}}}}}},
        {"if": {"properties": {"reproducibility": {"const": "reproducible"}}}, "then": {"properties": {"opaque_limitations": {"maxItems": 0}, "deployments": {"properties": {"publisher": {"properties": {"visibility": {"const": "reproducible"}}}, "relay": {"properties": {"visibility": {"const": "reproducible"}}}, "subscriber": {"properties": {"visibility": {"const": "reproducible"}}}}}}}},
        {"if": {"properties": {"reproducibility": {"const": "opaque"}}}, "then": {"properties": {"opaque_limitations": {"minItems": 1}, "deployments": {"anyOf": [{"properties": {"publisher": {"properties": {"visibility": {"const": "opaque"}}}}}, {"properties": {"relay": {"properties": {"visibility": {"const": "opaque"}}}}}, {"properties": {"subscriber": {"properties": {"visibility": {"const": "opaque"}}}}}]}}}},
        {"if": {"properties": {"identity": {"properties": {"driver_binding": {"const": "moxygen_driver"}}}}}, "then": {"properties": {"identity": {"properties": {"source_binding": {"$ref": "#/definitions/source_binding_identity"}}}, "independence_class": {"const": "moxygen-driver-binding"}}}},
