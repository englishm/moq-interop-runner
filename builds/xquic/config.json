{
  "name": "xquic",
  "description": "Alibaba's draft-22 QUIC/WebTransport client and relay",
  "repository": "https://github.com/alibaba/xquic.git",
  "default_ref": "dev/moqt-interop",
  "targets": {
    "client": {
      "dockerfile": "Dockerfile.client",
      "image_name": "xquic-client",
      "registry_image": "ghcr.io/englishm/moq-interop-runner-xquic-client",
      "context": ".sources/xquic"
    },
    "relay": {
      "dockerfile": "Dockerfile.relay",
      "image_name": "xquic-relay",
      "registry_image": "ghcr.io/englishm/moq-interop-runner-xquic-relay",
      "context": ".sources/xquic"
    }
  }
}
