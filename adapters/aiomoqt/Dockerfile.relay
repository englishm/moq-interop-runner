# aiomoqt adapter for MoQT interop testing (relay role)
#
# aiomoqt interop relay (draft-14/16/18): SETUP, PUBLISH_NAMESPACE, PUBLISH,
# SUBSCRIBE and FETCH, forwarding objects; RENDEZVOUS_TIMEOUT on draft-18.
#
# One UDP port serves raw QUIC (moqt://) and H3/WebTransport (https://),
# chosen per connection by the negotiated ALPN (MOQT_DUAL=1). Both the
# aiomoqt-relay and aiomoqt-relay-quic entries build this file; they differ
# only in image tag and URL.
#
# Build:
#   docker build -t aiomoqt-interop-relay:latest \
#     -f adapters/aiomoqt/Dockerfile.relay adapters/aiomoqt/
#
# Usage:
#   docker run -v ./certs:/certs -p 4443:4443/udp aiomoqt-interop-relay:latest
FROM ghcr.io/gmarzot/aiomoqt:0.12.0a3

# The image's entrypoint reads these (docker-entrypoint.sh): relay role,
# both transports on one port, draft-18/16/14 newest first. Certs default to
# /certs/cert.pem + /certs/priv.key.
ENV MOQT_ROLE=relay
ENV MOQT_PORT=4443
ENV MOQT_DUAL=1
ENV MOQT_DRAFT=18,16,14

EXPOSE 4443/udp

# The python:slim base lacks ss/netstat; check /proc/net/udp(6) for port
# 4443 (0x115B).
HEALTHCHECK --interval=2s --timeout=5s --start-period=5s --retries=10 \
    CMD grep -qi ":115B" /proc/net/udp6 || grep -qi ":115B" /proc/net/udp || exit 1
